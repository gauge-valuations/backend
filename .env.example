# Template only. Copy to .env.local for local development.
# The real value lives ONLY in Vercel env vars and a password manager --
# never in this file, never in any committed file, never in logs or responses.
RENTCAST_API_KEY=

# Comma-separated exact origins allowed to call /api/property from a browser, e.g.
# https://my-app.vercel.app,http://localhost:8081. No wildcard. Blank = no CORS
# headers at all (native apps don't need them).
ALLOWED_ORIGINS=

# Demo gate: when set, /api/property requires a matching X-Demo-Key header.
# A speed bump to protect the request quota, NOT a secret, because the matching
# value ships in the client bundle. Blank = gate off (local dev).
DEMO_KEY=

# Upstash Redis for the report cache. Blank = in-memory cache (per process).
# The URL is not sensitive; the TOKEN IS A SECRET -- Vercel env vars only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
