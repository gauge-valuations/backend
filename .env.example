# Template only. Copy to .env.local for local development.
# The real value lives ONLY in Vercel env vars and a password manager --
# never in this file, never in any committed file, never in logs or responses.
RENTCAST_API_KEY=

# Comma-separated exact origins allowed to call /api/property from a browser, e.g.
# https://my-app.vercel.app,http://localhost:8081. No wildcard. Blank = no CORS
# headers at all (native apps don't need them).
ALLOWED_ORIGINS=

# Demo gate: when set, /api/property requires a matching X-Demo-Key header.
# A speed bump to protect the request quota, NOT a secret, because the matching
# value ships in the client bundle. Blank = gate off (local dev).
# scripts/warm-cache.ts also reads this to send X-Demo-Key.
DEMO_KEY=

# Upstash Redis for the report cache and the call-budget counter. Blank = in-memory
# (per process; in production uncached reports are then refused -- see CLAUDE.md).
# The URL is not sensitive; the TOKEN IS A SECRET -- Vercel env vars only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max billable Rentcast calls per billing month (resets on BILLING_DAY, below); the
# Developer plan bills $0.20 per call beyond 50, so keep this under the plan's
# included amount. Blank = 40.
MONTHLY_CALL_BUDGET=

# Day of the month the Rentcast plan renews, 1-28; the monthly call budget resets on
# this day (UTC). Blank = 1.
BILLING_DAY=

# Used only by scripts/warm-cache.ts: the deployed backend to warm, e.g.
# https://gauge-backend.vercel.app (no trailing slash). https only, or http://localhost.
BASE_URL=
